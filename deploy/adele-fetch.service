[Unit]
Description=adele: fetch the datasets whose refresh is due
After=network-online.target

[Service]
Type=oneshot
User=adele
Group=adele
UMask=0027
# Source credentials. Each fetch.py gets only the ones that its descriptor lists in adele.secrets
# (plus PATH, HOME, locale, certificates, proxies, UV_*, PYTHON*, XDG_*).
EnvironmentFile=/etc/adele/env
# fetch.py files run with `uv run --script` (PEP 723); uv in /usr/local/bin, its cache outside the data
Environment=UV_CACHE_DIR=/var/cache/adele/uv
Environment=UV_PYTHON_INSTALL_DIR=/opt/uv-python
Environment=GOOGLE_APPLICATION_CREDENTIALS=/etc/adele/gcloud-adc.json
CacheDirectory=adele
ExecStart=/opt/adele/server/.venv/bin/adele-server --config /etc/adele/adele-server.toml fetch --due
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/adele
ReadWritePaths=/var/lib/adele /var/log/adele
