# HTTPS in front of adele-server (D35, 2026-11-23). deploy/access.sh writes it to
# /etc/adele-caddy/Caddyfile with the DNS name of the server in place of ADELE_HOST (the name is
# not in git). adele-server stays on 127.0.0.1:8000; only Caddy listens on the network, on 8443.
# Ports 80 and 443 belong to another site, so there is no Let's Encrypt check: the certificate
# comes from Caddy's own authority (`tls internal`), whose root is in the client package.
{
	# no admin API on localhost:2019: a change of this file needs a restart of the unit
	admin off
	persist_config off
	# the root certificate is for the client package, not for the trust store of this machine
	skip_install_trust
	# no listener on port 80
	auto_https disable_redirects
	# the authority's private key: keep a backup, a new authority needs a new client for everyone
	storage file_system /var/lib/adele-caddy
	servers {
		protocols h1 h2
		# no limit on writing the answer: a query may wait 60 s and run 30 s
		timeouts {
			read_header 10s
			read_body 10s
			idle 2m
		}
	}
	pki {
		ca local {
			name "adele"
			root_cn "adele root CA"
			intermediate_cn "adele intermediate CA"
		}
	}
}

https://ADELE_HOST:8443 {
	tls internal

	# agent SQL arrives as a small JSON body
	request_body {
		max_size 64KB
	}

	reverse_proxy 127.0.0.1:8000

	# to the journal; Caddy writes REDACTED for the Authorization header
	log
}
